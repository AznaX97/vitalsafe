{
  "uid": "vitalsafe-overview",
  "title": "VitalSafe overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{status}}",
        "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"vitalsafe-api\"}[1m]))" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "95th percentile response time (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"vitalsafe-api\"}[5m])))" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Readings saved (last 5 minutes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{type}} via {{source}}",
        "expr": "sum by (type, source) (increase(vitalsafe_readings_saved_total[5m]))" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "CSV rows (last hour)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{result}}",
        "expr": "sum by (result) (increase(vitalsafe_csv_rows_total[1h]))" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "JVM heap used (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "heap",
        "expr": "sum(jvm_memory_used_bytes{application=\"vitalsafe-api\",area=\"heap\"})" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Database connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "active", "expr": "hikaricp_connections_active{application=\"vitalsafe-api\"}" },
        { "refId": "B", "legendFormat": "waiting", "expr": "hikaricp_connections_pending{application=\"vitalsafe-api\"}" }
      ]
    }
  ]
}
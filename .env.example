DB_PASSWORD=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me
# true shows the API docs at /swagger-ui/index.html. Keep it false anywhere other than your own PC.
OPENAPI_ENABLED=false
# 32 or more random characters. Empty keeps the metrics endpoint closed.
METRICS_TOKEN=
# Password for the local Grafana dashboards
GRAFANA_PASSWORD=change_me
# Development only: the fake mail server from docker-compose.mail.yml. Leave empty to send no email.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=

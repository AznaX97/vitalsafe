# Copy to .env.prod with scripts/new-prod-env.ps1, which generates the secrets. Never commit .env.prod.
DOMAIN=localhost
# 0 turns HSTS off. On a real domain start with 300 (5 minutes), and raise it to 31536000 once everything works.
HSTS_MAX_AGE=0
DB_PASSWORD=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me
{$DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age={$HSTS_MAX_AGE:0}"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }

    # The API goes to the backend container. A request body of more than 1 MB is refused (CSV imports are 512 KB at most).
    handle /api/* {
        request_body {
            max_size 1MB
        }
        reverse_proxy backend:8090
    }

    # Never reachable from outside. Without this rule, the fallback below would answer these paths with the home page.
    @internal path /actuator /actuator/* /v3 /v3/* /swagger-ui /swagger-ui/* /swagger-ui.html
    handle @internal {
        respond "Not found" 404
    }

    # Everything else is the React app
    handle {
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @pages not path /assets/*
        header @pages Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}